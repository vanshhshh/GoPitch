# Copy to .env and fill in. Never commit real values.

# --- Core ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=                     # long random string
NODE_ENV=production
PORT=4000
# Comma-separated list of allowed browser origins (apex + www if both are used)
FRONTEND_URL=https://gopitch.example

# 32-byte hex key for encrypting Gmail refresh tokens. Generate once; rotating it
# invalidates every stored Gmail connection (users must reconnect).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_ENCRYPTION_KEY=

# --- Razorpay (test keys in staging, live keys in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # set in Razorpay Dashboard → Webhooks

# --- Google OAuth (one OAuth client, two redirect URIs) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.gopitch.example/auth/google/callback
GOOGLE_SIGNIN_REDIRECT_URI=https://api.gopitch.example/auth/google/signin/callback
# metadata (default: gmail.send + gmail.metadata) | send (no reply tracking) | modify (legacy)
GMAIL_OAUTH_SCOPE=metadata
GMAIL_WATCHER_ENABLED=true

# --- AI providers (any subset; tried in priority order with fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMAIL_PROVIDER_PRIORITY=groq,gemini,openrouter,anthropic
DECK_PROVIDER_PRIORITY=groq,gemini,openrouter,anthropic
AI_REQUEST_TIMEOUT_MS=30000

# --- Enterprise plan limits (optional overrides) ---
# ENTERPRISE_INVESTOR_EMAIL_LIMIT=2000
# ENTERPRISE_ACTIVE_CAMPAIGN_LIMIT=

# --- Dev only: never enable in production ---
SMTP_FALLBACK_ENABLED=false
SMTP_USER=
SMTP_APP_PASSWORD=
